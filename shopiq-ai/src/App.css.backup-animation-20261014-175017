/* SHOPIQ AI — REFINED EDITORIAL HERO */
.hero-art-premium {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 510px;
  padding: 20px 12px 34px 22px;
  overflow: visible;
  background: transparent;
}

.hero-editorial-image {
  position: relative;
  width: 100%;
  height: clamp(400px, 42vw, 550px);
  overflow: hidden;
  background: #e8e2d6;
  border-radius: 3px;
  box-shadow: 0 24px 70px rgba(37, 55, 39, .12);
}

.hero-editorial-image::after {
  content: "";
  position: absolute;
  inset: 35% 0 0;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(17, 29, 21, .2) 38%,
    rgba(17, 29, 21, .82) 100%
  );
  pointer-events: none;
}

.hero-editorial-image > img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform .8s cubic-bezier(.2, .65, .25, 1);
}

.hero-editorial-image:hover > img {
  transform: scale(1.035);
}

.hero-image-label {
  position: absolute;
  z-index: 1;
  top: 22px;
  left: 22px;
  padding: 10px 13px;
  color: #233b2b;
  background: rgba(249, 247, 239, .94);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 2px;
}

.hero-image-caption {
  position: absolute;
  z-index: 1;
  left: clamp(20px, 3vw, 36px);
  right: 20px;
  bottom: 30px;
  color: #fffdf7;
}

.hero-image-caption > span {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2.5px;
}

.hero-image-caption h2 {
  margin: 13px 0 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(35px, 4vw, 55px);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -1.6px;
}

.hero-image-caption h2 em {
  color: #e0e6d5;
  font-weight: 400;
}

.hero-floating-note {
  position: absolute;
  z-index: 2;
  left: 0;
  bottom: 2px;
  display: flex;
  align-items: center;
  gap: 12px;
  max-width: calc(100% - 34px);
  padding: 15px 19px;
  color: #263a2b;
  background: #fbf9f2;
  border: 1px solid #e8e3d8;
  box-shadow: 0 12px 35px rgba(29, 44, 32, .1);
}

.hero-note-icon {
  display: grid;
  place-items: center;
  width: 37px;
  height: 37px;
  flex-shrink: 0;
  color: #fbf9f2;
  background: #2c4934;
  border-radius: 50%;
}

.hero-floating-note b,
.hero-floating-note small {
  display: block;
}

.hero-floating-note b {
  font-size: 11px;
  font-weight: 700;
}

.hero-floating-note small {
  margin-top: 5px;
  color: #777b70;
  font-size: 10px;
}

.hero-edition-mark {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  display: grid;
  place-content: center;
  width: 66px;
  height: 66px;
  color: #294432;
  background: #e8e8d9;
  border: 1px solid rgba(255, 255, 255, .8);
  border-radius: 50%;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 16px;
  line-height: 1;
  text-align: center;
  transform: rotate(8deg);
}

.hero-edition-mark span {
  margin-top: 4px;
  font-family: sans-serif;
  font-size: 11px;
}

@media (max-width: 900px) {
  .hero-art-premium {
    min-height: 390px;
    padding: 10px 8px 26px 14px;
  }

  .hero-editorial-image {
    height: clamp(350px, 56vw, 470px);
  }
}

@media (max-width: 600px) {
  .hero-art-premium {
    min-height: 360px;
    padding: 8px 5px 26px 8px;
  }

  .hero-editorial-image {
    height: 370px;
  }

  .hero-image-label {
    top: 15px;
    left: 15px;
    font-size: 8px;
  }

  .hero-image-caption {
    left: 18px;
    bottom: 22px;
  }

  .hero-image-caption h2 {
    font-size: 38px;
  }

  .hero-floating-note {
    padding: 12px;
    gap: 9px;
  }

  .hero-floating-note b {
    font-size: 10px;
  }

  .hero-edition-mark {
    width: 54px;
    height: 54px;
    font-size: 13px;
  }
}


