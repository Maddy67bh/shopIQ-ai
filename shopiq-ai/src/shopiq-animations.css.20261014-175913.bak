@keyframes shopiqFloat { 0%,100% { transform:translateY(0) } 50% { transform:translateY(-10px) } } @keyframes shopiqGlow { 0%,100% { box-shadow:0 0 15px #10b98144 } 50% { box-shadow:0 0 35px #10b98199 } } @keyframes shopiqSpin { from { rotate:0deg } to { rotate:360deg } } .product-card,.product-item { transition:transform .3s ease,box-shadow .3s ease } .product-card:hover,.product-item:hover { transform:translateY(-6px);box-shadow:0 15px 35px #064e3b20 } .shopiq-ai-orb { animation:shopiqFloat 4s ease-in-out infinite,shopiqGlow 3s ease-in-out infinite } .shopiq-orbit { animation:shopiqSpin 10s linear infinite } @media(prefers-reduced-motion:reduce) { .shopiq-ai-orb,.shopiq-orbit { animation:none } }